# Mode
LOCAL_MODE=true
LOG_LEVEL=INFO

# Local paths (LOCAL_MODE only). Mirrors the S3 prefix layout below:
#   $DATA_DIR/landing   downloaded CSVs, pre-ingest
#   $DATA_DIR/raw       typed parquet mirror of the CSVs   <- S3_RAW_PREFIX
#   $DATA_DIR/curated   cleaned/joined tables and labels   <- S3_CURATED_PREFIX
#   $DATA_DIR/features  feature matrices                   <- S3_FEATURES_PREFIX
#   $DATA_DIR/scores    batch transform output             <- S3_SCORES_PREFIX
DATA_DIR=./data

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
S3_BUCKET=pdm-platform
S3_RAW_PREFIX=raw/
S3_CURATED_PREFIX=curated/
S3_FEATURES_PREFIX=features/
S3_SCORES_PREFIX=scores/

# Glue
GLUE_DATABASE=pdm_catalog
GLUE_ROLE_ARN=arn:aws:iam::...:role/pdm-glue-role

# SageMaker
SAGEMAKER_ROLE_ARN=arn:aws:iam::...:role/pdm-sagemaker-role
SAGEMAKER_TRAINING_INSTANCE=ml.m5.xlarge
SAGEMAKER_TRANSFORM_INSTANCE=ml.m5.large

# MLflow
# sqlite, not file:./mlruns — MLflow 3.x refuses the filesystem store and the
# model registry never supported it. Still local, still no server.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT=pdm-failure-24h
MLFLOW_MODEL_NAME=pdm-xgb

# Problem definition
PREDICTION_HORIZON_HOURS=24
FEATURE_CADENCE_HOURS=3
WINDOW_SIZES_HOURS=3,12,24
POST_FAILURE_EXCLUSION_HOURS=24

# Splits (time-based, with a gap >= horizon)
TRAIN_END=2015-08-31
GAP_HOURS=24
VAL_END=2015-10-31

# Decision economics
COST_FALSE_ALARM=250
COST_MISSED_FAILURE=10000
DECISION_THRESHOLD=0.0   # 0.0 means "derive from cost curve at eval time"
